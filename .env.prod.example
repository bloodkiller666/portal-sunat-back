# Plantilla de producción para docker compose. Copie a `.env.prod` y complete.
# `.env.prod` NUNCA se versiona. Los valores sensibles van vacíos aquí.

# --- Entorno -----------------------------------------------------------------
ENVIRONMENT=prod
SUNAT_ENV=prod
CONFIRM_PROD_EMISSION=false
DEBUG=false
DOCS_ENABLED=false
LOG_JSON=true
LOG_LEVEL=INFO
SUNAT_VERIFY_SSL=true
WEB_CONCURRENCY=1

# --- Frontend permitido (dominio exacto, sin barra final ni *) -----------------
CORS_ORIGINS=https://factura-sunat.vercel.app

# --- Supabase ------------------------------------------------------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWT_ALG=ES256
SUPABASE_JWT_SECRET=
DATABASE_URL=
DATABASE_APPLY_RLS=true

# --- Cloudflare R2 (bucket privado) --------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Credenciales SUNAT por empresa (RUC en el nombre) -------------------------
SUNAT_CRED_20514831620_SOL_USER=
SUNAT_CRED_20514831620_SOL_PASSWORD=
SUNAT_CRED_20514831620_CLIENT_ID=
SUNAT_CRED_20514831620_CLIENT_SECRET=
# Solo al activar la emisión (monte ./secrets en docker-compose.yml):
# SUNAT_CRED_20514831620_CERT_PATH=/app/secrets/20514831620.pfx
# SUNAT_CRED_20514831620_CERT_PASSWORD=
