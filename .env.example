# Portal de Facturación Electrónica — configuración de ejemplo.
# Copia este archivo a `.env` y completa los valores. El `.env` real NUNCA se
# versiona (regla 1: sin secretos en el repo).

# ---------------- Aplicación ----------------
APP_NAME=Portal de Facturación Electrónica
APP_VERSION=0.1.0
# local | dev | staging | prod
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------- SUNAT ----------------
# beta (por defecto, ambiente de pruebas) | prod
SUNAT_ENV=beta
# En prod la emisión exige CONFIRM_PROD_EMISSION=true (sin esto responde 403).
CONFIRM_PROD_EMISSION=false
SUNAT_TIMEOUT_SECONDS=20
SUNAT_MAX_RETRIES=2
SUNAT_VERIFY_SSL=true
# Overrides puntuales de endpoints (dejar vacío para usar las URLs oficiales).
SUNAT_BILL_SERVICE_URL=
SUNAT_CONSULT_SERVICE_URL=
# Directorio para cachear los WSDL en disco (vacío = zeep los descarga).
SUNAT_WSDL_DIR=
# Comprobante de prueba que usa la sonda /sunat/status.
SUNAT_PROBE_TIPO=01
SUNAT_PROBE_SERIE=F001
SUNAT_PROBE_NUMERO=1

# ---------------- Supabase ----------------
# Valores de EJEMPLO: los reales se copian del panel de Supabase y nunca se versionan.
SUPABASE_URL=https://<project-ref>.supabase.co
# HS256 usa SUPABASE_JWT_SECRET (proyectos legacy); ES256/RS256 usan el JWKS.
SUPABASE_JWT_ALG=ES256
SUPABASE_JWT_SECRET=<jwt-secret-del-proyecto>
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# ---------------- Base de datos ----------------
# Postgres de Supabase (puerto directo 5432 o pooler en modo sesión).
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
DATABASE_APPLY_RLS=true

# ---------------- CORS ----------------
# Orígenes del SPA, sin barra final. CSV o JSON; en staging/prod no se admite *.
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-Id

# ---------------- Secretos ----------------
# env (variables de entorno) | azure_keyvault (stub, fase posterior)
SECRETS_PROVIDER=env
AZURE_KEYVAULT_URL=

# ---------------- Almacenamiento de archivos (Cloudflare R2) ----------------
# R2 es el único proveedor de almacenamiento. El bucket es PRIVADO:
# los archivos se descargan con URLs firmadas temporales, nunca con URL pública.
# Endpoint S3: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Token de API de R2 (Access Key ID + Secret Access Key). NUNCA se versionan.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Override opcional del endpoint S3 (vacío = se deriva de R2_ACCOUNT_ID).
R2_ENDPOINT_URL=
# Vigencia de las URLs firmadas de descarga, en segundos (máximo 604800 = 7 días).
R2_SIGNED_URL_EXPIRES_SECONDS=900

# ---------------- Credenciales SUNAT por empresa ----------------
# Una línea por empresa usando el RUC como sufijo. El usuario SOL viaja a SUNAT
# como `RUC + usuario SOL`. Nada de esto se versiona.
# SUNAT_CRED_20123456789_SOL_USER=MIUSUARIO
SUNAT_CRED_20123456789_SOL_PASSWORD=
SUNAT_CRED_20123456789_CERT_PATH=secrets/20123456789.pfx
SUNAT_CRED_20123456789_CERT_PASSWORD=
# Fase REST (cliente id, por ejemplo para SIRE): opcional en esta fase.
SUNAT_CRED_20123456789_CLIENT_ID=
SUNAT_CRED_20123456789_CLIENT_SECRET=
