# Copia este archivo a .env y completa los valores. .env NUNCA se versiona.
# Ninguna credencial real debe vivir en el repositorio (regla 1).

# ---------------- Aplicación ----------------
APP_NAME=Portal de Facturación Electrónica
APP_VERSION=0.1.0
# local | dev | staging | prod
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------- SUNAT ----------------
# beta | prod. Por defecto beta: es el ambiente para pruebas.
SUNAT_ENV=beta
# false bloquea cualquier operación de EMISIÓN cuando SUNAT_ENV=prod (regla 4).
CONFIRM_PROD_EMISSION=false
SUNAT_TIMEOUT_SECONDS=20
SUNAT_MAX_RETRIES=2
SUNAT_VERIFY_SSL=true
# Opcionales: si se dejan vacíos se usan las URLs oficiales según SUNAT_ENV.
SUNAT_BILL_SERVICE_URL=
# La consulta de CDR no existe en beta: apunta siempre a producción (solo lectura).
# Requiere credenciales SOL de producción; las de beta no autentican contra prod.
SUNAT_CONSULT_SERVICE_URL=https://e-factura.sunat.gob.pe/ol-it-wsconscpegem/billConsultService
# Opcional: carpeta con los WSDL guardados localmente (evita descargarlos en cada arranque).
SUNAT_WSDL_DIR=
# Parámetros de la sonda usada por /sunat/status para probar la autenticación.
SUNAT_PROBE_TIPO=01
SUNAT_PROBE_SERIE=F001
SUNAT_PROBE_NUMERO=1

# ---------------- Supabase (auth + Postgres) ----------------
SUPABASE_URL=
# HS256 para el JWT secret legacy; ES256/RS256 si el proyecto usa signing keys asimétricas.
SUPABASE_JWT_ALG=HS256
SUPABASE_JWT_SECRET=
# Solo para algoritmos asimétricos: si se deja vacío se deriva de SUPABASE_URL.
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Si se deja vacío se deriva como {SUPABASE_URL}/auth/v1
SUPABASE_JWT_ISSUER=
# Conexión Postgres (usar el puerto 5432/directo o el pooler en modo sesión).
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
# true aplica RLS: cada request fija request.jwt.claims y `set local role authenticated`.
DATABASE_APPLY_RLS=true

# ---------------- CORS ----------------
# Lista separada por comas o JSON. En staging/prod no se permite "*".
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-Id

# ---------------- Secretos por empresa ----------------
# env (desarrollo) | azure_keyvault (fase posterior)
SECRETS_PROVIDER=env
AZURE_KEYVAULT_URL=
# Patrón por RUC de 11 dígitos. Un juego de variables por cada empresa del grupo.
# El usuario SOL viaja como RUC + usuario (ej. 20123456789MODDATOS).
SUNAT_CRED_20123456789_SOL_USER=
SUNAT_CRED_20123456789_SOL_PASSWORD=
SUNAT_CRED_20123456789_CERT_PATH=secrets/20123456789.pfx
SUNAT_CRED_20123456789_CERT_PASSWORD=
# Fase posterior (API REST con OAuth2). Pueden quedar vacías.
SUNAT_CRED_20123456789_CLIENT_ID=
SUNAT_CRED_20123456789_CLIENT_SECRET=
