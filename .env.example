# Plantilla de configuración. Copie a `.env` y complete; `.env` NUNCA se versiona.
# Las claves (SOL, certificado, API REST SUNAT, R2, DATABASE_URL) van siempre vacías aquí.

APP_NAME=Portal de Facturación Electrónica
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=false
SUNAT_ENV=beta
CONFIRM_PROD_EMISSION=false
SUNAT_TIMEOUT_SECONDS=20.0
SUNAT_MAX_RETRIES=2
SUNAT_VERIFY_SSL=true
SUNAT_BILL_SERVICE_URL=
SUNAT_CONSULT_SERVICE_URL=
SUNAT_WSDL_DIR=
SUNAT_PROBE_TIPO=01
SUNAT_PROBE_SERIE=F001
SUNAT_PROBE_NUMERO=1
SUPABASE_URL=
SUPABASE_JWT_ALG=HS256
SUPABASE_JWT_SECRET=
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
DATABASE_URL=
# Conexiones que se abren al arrancar: con la base remota cada una tarda ~1-2 s en abrirse,
# así que se precalientan (3-4 cubren una pantalla que pide lista, resumen y precarga).
DATABASE_POOL_MIN_SIZE=3
DATABASE_POOL_MAX_SIZE=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30.0
DATABASE_APPLY_RLS=true
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=
CORS_ALLOW_HEADERS=
SECRETS_PROVIDER=env
AZURE_KEYVAULT_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_SIGNED_URL_EXPIRES_SECONDS=900

# Credenciales por empresa (RUC en el nombre). La clave SOL, la del certificado y el
# client_secret de la API REST de SUNAT se completan solo en el entorno real.
SUNAT_CRED_20123456789_SOL_USER=MODDATOS
SUNAT_CRED_20123456789_SOL_PASSWORD=
SUNAT_CRED_20123456789_CERT_PATH=secrets/20123456789.pfx
SUNAT_CRED_20123456789_CERT_PASSWORD=
SUNAT_CRED_20123456789_CLIENT_ID=
SUNAT_CRED_20123456789_CLIENT_SECRET=
